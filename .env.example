# Kopioi tämä tiedostoksi .env ja täytä arvot. .env on .gitignoressa.
#
# ÄLÄ täytä oikeita arvoja tähän tiedostoon — tämä on malli, joka menee gittiin.
# Oikeat tunnukset kuuluvat vain .env-tiedostoon.
#
# LAINAUSMERKIT SALASANOIHIN. Node lukee tämän tiedoston `--env-file`-lipulla,
# ja se katkaisee lainausmerkittömän arvon RISUAIDAN (#) kohdalta — loput
# katoavat äänettömästi. Salasana `Ab#cdef` menee siis perille muodossa `Ab`,
# eikä mikään kerro siitä: palvelin yrittää kirjautua katkelmalla, saa 401:n ja
# näyttää "tarkista tunnukset". Sama koskee välilyöntejä. Kirjoita siis:
#
#   WILMA_PASSWORD="salasana#jossa on merkkejä"
#
# Lainausmerkit ovat aina turvalliset, myös kun niitä ei tarvita.

# --- Palvelin ---
PORT=4173
# Lokitaso.
#   warn  = oletus. Virheet ja niistä palautumiset — muutama rivi vuodessa,
#           koska lokitetaan vain tilan muutokset, ei jokaista hakukierrosta.
#   error = pelkät virheet, ei palautumisrivejä.
#   debug = vianetsintä: kaikki haut lokiin, konsoli mukaan ja rikkoutuneesta
#           Wilma-vastauksesta tallennetaan raaka HTML data/snapshots-kansioon.
LOG_LEVEL=warn

# --- Sää (Open-Meteo, ei API-avainta) ---
# Oletuskoordinaatit: Karstula (43500).
WEATHER_LAT=62.86667
WEATHER_LON=24.78333
WEATHER_PLACE=Karstula

# --- Wilma ---
# Koulun Wilma-osoite, esim. https://helsinki.inschool.fi
WILMA_BASE_URL=
WILMA_USERNAME=
WILMA_PASSWORD=

# --- Päikky (varhaiskasvatus) ---
# Kunnan oma Päikky-osoite, esim. https://karstula.paikky.fi. Sama alusta
# pyörii kymmenissä kunnissa, kukin omalla aliverkkotunnuksellaan.
PAIKKY_BASE_URL=https://karstula.paikky.fi
# Käyttäjätunnus on huoltajan puhelinnumero, sama jolla kirjaudut sovellukseen.
PAIKKY_USERNAME=
# HUOM: tili lukkiutuu epäonnistuneista kirjautumisista, ja sama tunnus on
# huoltajan omassa puhelimessa. Väärä salasana täällä kaataa siis muutakin kuin
# näytön — tarkista se kerralla oikein.
PAIKKY_PASSWORD=

# --- Perhekalenteri ---
# Google Calendar: Asetukset -> Kalenterin asetukset -> Salainen osoite iCal-muodossa
CALENDAR_ICS_URL=

# --- Puhelimen muokkausoikeus: kaksi tasoa, sama kenttä käyttöliittymässä ---
# Molemmat toimivat "x-edit-pin"-otsikon kautta — käyttöliittymässä on yksi
# PIN-syöttökenttä, ja palvelin päättää kumpaan (jos kumpaankaan) annettu
# koodi täsmää. Jätä kumpikin tyhjäksi = muokkaus vain näyttölaitteelta/
# TRUSTED_HOSTS-laitteilta, eikä käyttöliittymä tarjoa PIN-syöttöä lainkaan.

# EDIT_PIN: muistilistan, asetusten ja hälytysten muokkaus. EI näytä lasten
# Wilma-tietoja. Neljä numeroa on tähän käytännössä riittävä — panokset ovat
# pienemmät kuin FULL_PINissä. Jätä tyhjäksi = tämä taso ei ole käytössä.
EDIT_PIN=

# FULL_PIN: täydet oikeudet — sama kuin TRUSTED_HOSTS-listalla oleva laite,
# MYÖS lasten Wilma-tiedot (lukujärjestys, viestit, kokeet). Käytä tätä kun
# TRUSTED_HOSTS ei sovi (esim. puhelimen IP vaihtuu DHCP:ssä). Vähintään 6
# merkkiä — lyhyempi arvo EI OTA tasoa käyttöön lainkaan (palvelin kirjaa
# tästä yhden varoitusrivin lokiin käynnistyksessä, ei koodia itseään).
# Jätä tyhjäksi = tämä taso ei ole käytössä.
FULL_PIN=

# --- Luotetut laitteet ---
# Pilkulla erotettu lista IP-osoitteita ja/tai konenimiä, jotka saavat samat
# oikeudet kuin näyttölaite itse (myös lasten Wilma-data, ei vain sää ja
# muistilista) — sama taso kuin FULL_PIN, mutta laitekohtaisesti eikä koodilla.
# Esim: TRUSTED_HOSTS=192.168.10.50,antin-puhelin.local
# Jätä tyhjäksi = ei yhtään luotettua laitetta (nykyinen käytös). Muutos vaatii
# palvelimen uudelleenkäynnistyksen — listaa ei voi muokata käyttöliittymästä
# tai rajapinnasta tarkoituksella. Ei aliverkkoja (esim. 192.168.10.0/24).
TRUSTED_HOSTS=

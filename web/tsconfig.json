{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "jsx": "preserve",
    "isolatedModules": true,
    // Web-testit ajetaan suoraan Nodella, joka vain riisuu tyypit eikä muunna
    // syntaksia. Konstruktorin parametrikentät ja vastaavat läpäisivät
    // tyyppitarkistuksen mutta kaatoivat ajon — sama rajoite kuin
    // palvelinpuolella, joten sama suoja tänne. Virhe käännösaikana on
    // parempi kuin kaatuminen selaimessa.
    "erasableSyntaxOnly": true,
    // Testit ajetaan suoraan Nodella ilman käännösvaihetta, ja Node vaatii
    // .ts-päätteen suhteellisiin tuonteihin.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "test/**/*.ts", "vite.config.ts"]
}

{
  "name": "@infonaytto/server",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/index.ts",
    "start": "node --env-file-if-exists=../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:providers": "node test/provider-transitions.ts",
    "test:providers-manual": "node test/provider-manual-test.ts",
    "test:calendar": "node test/calendar-events.ts",
    "test:calendar-month": "node test/calendar-month.ts",
    "test:wilma": "node test/wilma-fetch.ts",
    "test:wilma-session": "node test/wilma-session.ts",
    "test:prices": "node test/price-history.ts",
    "test:message-reads": "node test/message-reads.ts",
    "test:trusted-hosts": "node test/trusted-hosts.ts",
    "test:alarm-settings": "node test/alarm-settings.ts",
    "test:alarm-sounds": "node test/alarm-sounds.ts",
    "test:postal-codes": "node test/postal-codes.ts",
    "test:news": "node test/news-feed.ts",
    "test:panels": "node test/panel-settings.ts",
    "test:edit-access": "node test/edit-access.ts",
    "test:edit-access-disabled": "node test/edit-access-disabled.ts",
    "test:edit-access-full-too-short": "node test/edit-access-full-too-short.ts",
    "test:kiosk": "node test/kiosk.ts",
    "test:kiosk-exit": "node test/kiosk-exit.ts",
    "test:kiosk-exit-disabled": "node test/kiosk-exit-disabled.ts",
    "test:kiosk-exit-full-too-short": "node test/kiosk-exit-full-too-short.ts",
    "test:smoke": "node --env-file-if-exists=../.env test/wilma-smoke.ts",
    "test:household": "node test/household.ts",
    "test:menu": "node test/menu.ts && node test/menu-selection.ts",
    "test:namedays": "node test/namedays.ts",
    "test:waste": "node test/waste-vingo.ts && node test/waste-service.ts && node test/waste-lockout.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@wilm-ai/wilma-client": "1.4.2",
    "fastify": "^5.2.1",
    "node-ical": "^0.27.1",
    "pino": "^9.6.0",
    "pino-roll": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  }
}
